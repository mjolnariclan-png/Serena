{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "git reset --hard *": "deny"
    },
    "webfetch": "allow",
    "question": "deny",
    "doom_loop": "allow",
    "external_directory": "deny"
  },

  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  },

  "model": "nvidia/openai/gpt-oss-20b"
}
